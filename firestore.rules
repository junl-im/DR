rules_version = '2';
// localSaves/{uid}: private, untrusted single-player saves only.
// uid string immutable by path; schemaVersion int=1; mode='local';
// payload JSON string <=50k; updatedAt server timestamp. No public economy.
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function validSave(uid) {
      let d = request.resource.data;
      return d.keys().hasAll(['uid','schemaVersion','mode','payload','updatedAt'])
        && d.keys().hasOnly(['uid','schemaVersion','mode','payload','updatedAt'])
        && d.uid == uid && d.schemaVersion == 1 && d.mode == 'local'
        && d.payload is string && d.payload.size() > 0 && d.payload.size() <= 50000
        && d.updatedAt == request.time;
    }
    match /localSaves/{uid} {
      allow get: if owner(uid);
      allow list: if false;
      allow create, update: if owner(uid) && validSave(uid);
      allow delete: if owner(uid);
    }
    match /{document=**} { allow read, write: if false; }
  }
}
